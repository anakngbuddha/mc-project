// Local dev uses SQLite so this runs with zero external installs.
// To move to Postgres later (Docker/CCE phase), change provider to
// "postgresql" and set DATABASE_URL to a postgres connection string —
// everything else in this schema and the app code stays the same.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CloudAccount {
  id               String   @id @default(cuid())
  name             String
  provider         String   // "aws" | "huawei" | "azure"
  encryptedPayload String   // AES-256-GCM encrypted JSON string of credentials
  iv               String   // Base64 encoded IV
  authTag          String   // Base64 encoded GCM Auth Tag
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([provider, enabled])
}

model Metric {
  id           String   @id @default(cuid())
  resourceId   String
  resourceType String
  provider     String // "aws" | "huawei" | "azure" | "mock"
  metricName   String
  value        Float
  unit         String?
  timestamp    DateTime @default(now())

  @@index([resourceId, metricName, timestamp])
  @@index([provider, timestamp])
}
